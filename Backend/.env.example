# Servidor
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (Anthropic)
ANTHROPIC_API_KEY=

# Whisper (OpenAI) — se usará en el módulo de transcripciones, no en este paso
OPENAI_API_KEY=

# Frontend (para redirects de Supabase Auth, ej. recuperación de contraseña)
FRONTEND_URL=http://localhost:3000/reset-password

# Pagos — webhook de PayPal (POST /api/payments/webhook)
# Producción: https://ipnpb.paypal.com/cgi-bin/webscr
# Sandbox:    https://ipnpb.sandbox.paypal.com/cgi-bin/webscr
PAYPAL_IPN_VERIFY_URL=https://ipnpb.paypal.com/cgi-bin/webscr

# Suscripción mensual de PayPal (avisos en POST /api/subscriptions/paypal-events)
# PAYPAL_MODE: "sandbox" (prueba, por defecto) o "live" (cobra dinero real).
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_PLAN_ID=
PAYPAL_WEBHOOK_ID=
# A dónde vuelve el usuario después de PayPal (sin barra final). En local: http://localhost:3000
APP_URL=https://www.periodista-ia-app.com

# Subida directa de archivos grandes (navegador -> backend, sin el límite de 4,5 MB de Vercel).
# Clave para firmar los pases de subida, mínimo 32 caracteres. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Vacía = la subida directa queda apagada y todo sigue pasando por el proxy de Vercel.
UPLOAD_TICKET_SECRET=
# Dirección pública del backend. Por defecto: https://api.periodista-ia-app.com en
# producción y http://localhost:3001 en local.
# PUBLIC_API_URL=

# Resend (email de bienvenida al activar el plan Pro)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@periodista-ia.com

# Telegram (notificación al admin cuando alguien se hace Pro) — opcional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
